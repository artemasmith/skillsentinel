{
 "rules": [
  {
   "id": "SS001",
   "title": "Prompt injection: ignore previous instructions",
   "category": "prompt-injection",
   "severity": "critical",
   "owasp": "ASI-01",
   "pattern": "ignore\\s+(all\\s+)?(previous|prior|above|earlier|preceding)\\s+(instructions?|prompts?|rules?|directions?|messages?)",
   "description": "Classic instruction-override phrasing found in skill/prompt content.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS002",
   "title": "Prompt injection: disregard your instructions",
   "category": "prompt-injection",
   "severity": "critical",
   "owasp": "ASI-01",
   "pattern": "disregard|forget\\s+(all|your)\\s+(previous|prior|above)?.*?(instructions?|training|rules?)",
   "description": "Attempts to make the agent drop its directives.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS003",
   "title": "Prompt injection: role override / new persona",
   "category": "prompt-injection",
   "severity": "high",
   "owasp": "ASI-01",
   "pattern": "you\\s+are\\s+now\\s+(a|an|the)\\s+|from\\s+now\\s+on[,:]\\s+you\\s+are\\s+|act\\s+as\\s+(if\\s+you\\s+are\\s+)?(a|an)\\s+(different|new|unrestricted)\\s",
   "description": "Forced persona switch in skill text.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS004",
   "title": "System-prompt exfiltration request",
   "category": "prompt-injection",
   "severity": "critical",
   "owasp": "ASI-02",
   "pattern": "(reveal|print|show|repeat|output|display|exfiltrate|leak|send)\\s+(me\\s+)?(your|the)\\s+(system\\s+)?(prompt|instructions|initial\\s+message|hidden\\s+rules?|developer\\s+message)",
   "description": "Asks the agent to disclose its system prompt.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS005",
   "title": "Prompt injection: developer-mode / jailbreak toggle",
   "category": "prompt-injection",
   "severity": "high",
   "owasp": "ASI-01",
   "pattern": "developer\\s*mode|dan\\s*mode|jailbreak\\s*(mode)?|do\\s+anything\\s+now|godmode|unrestricted\\s+mode",
   "description": "Jailbreak-style mode switch phrases.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS006",
   "title": "Instruction to hide activity from the user",
   "category": "prompt-injection",
   "severity": "high",
   "owasp": "ASI-08",
   "pattern": "don'?t\\s+(tell|inform|notify|alert)\\s+(the\\s+)?(user|owner|human)|hide\\s+this\\s+(from|action\\s+from)\\s+(the\\s+)?(user|owner)|keep\\s+this\\s+secret\\s+from",
   "description": "Asks the agent to conceal its actions.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS007",
   "title": "Instruction to disable safety / guidelines",
   "category": "prompt-injection",
   "severity": "critical",
   "owasp": "ASI-01",
   "pattern": "(disable|ignore|bypass|turn\\s+off|do\\s+not\\s+apply)\\s+(all\\s+)?(your\\s+)?(safety|content\\s*policy|ethical|guardrails?|guidelines?|restrictions?|filters?)",
   "description": "Safety-bypass instruction.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS008",
   "title": "Invisible character: zero-width",
   "category": "invisible-unicode",
   "severity": "high",
   "owasp": "ASI-01",
   "pattern": "[\\u200b\\u200c\\u200d\\u2060\\ufeff]",
   "ignore_case": false,
   "description": "Zero-width chars can hide instructions from human review.",
   "kind": "intent",
   "context": "directive",
   "requires_pattern": null
  },
  {
   "id": "SS009",
   "title": "Invisible character: tag characters (U+E0000 block)",
   "category": "invisible-unicode",
   "severity": "critical",
   "owasp": "ASI-01",
   "pattern": "[\\U000e0000-\\U000e007f]",
   "ignore_case": false,
   "description": "Unicode tag characters — used in ASCII-smuggling attacks; never legitimate in prose.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS010",
   "title": "Bidi override characters",
   "category": "invisible-unicode",
   "severity": "high",
   "owasp": "ASI-01",
   "pattern": "[\\u202a-\\u202e\\u2066-\\u2069\\u061c]",
   "ignore_case": false,
   "description": "RTL/LTR isolates and overrides enable trojan-source style text rendering tricks.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS011",
   "title": "Variation selector used as hidden data channel",
   "category": "invisible-unicode",
   "severity": "medium",
   "owasp": "ASI-01",
   "pattern": "[\\ufe00-\\ufe0f\\U000e0100-\\U000e01ef]{3,}",
   "ignore_case": false,
   "description": "Variation selectors can encode hidden payloads inside visible text.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS012",
   "title": "ANSI escape sequence in prompt content",
   "category": "invisible-unicode",
   "severity": "medium",
   "owasp": "ASI-01",
   "pattern": "\\x1b\\[[0-9;]*[A-Za-z]",
   "ignore_case": false,
   "description": "Terminal control sequences can manipulate CLI tool output or hide text.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS013",
   "title": "Base64-encoded blob (possible payload obfuscation)",
   "category": "obfuscation",
   "severity": "medium",
   "owasp": "ASI-01",
   "pattern": "(?<![A-Za-z0-9+/])[A-Za-z0-9+/]{80,}={0,2}(?![A-Za-z0-9+/])",
   "ignore_case": false,
   "description": "Long base64 run — common way to hide injected instructions or C2 payloads.",
   "kind": "capability",
   "context": "code",
   "requires_pattern": "b64decode|base64\\s+-d|atob|FromBase64String|Convert\\.FromBase64|decodebytes|codecs\\.decode|b64d|openssl\\s+enc\\s+-d|base64\\.b64decode"
  },
  {
   "id": "SS014",
   "title": "Base64 eval/exec of encoded string",
   "category": "obfuscation",
   "severity": "critical",
   "owasp": "ASI-01",
   "pattern": "(eval|exec|atob|from_base64|b64decode|base64\\s+-d|openssl\\s+enc\\s+-base64)[^\\n]{0,40}[A-Za-z0-9+/]{20,}={0,2}",
   "description": "Decodes and immediately executes base64 data.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null,
   "escalate_pattern": "b64decode|base64\\s+-d|atob|FromBase64String|Convert\\.FromBase64|decodebytes|codecs\\.decode|base64\\.b64decode"
  },
  {
   "id": "SS015",
   "title": "Hex-encoded execution / long hex blob",
   "category": "obfuscation",
   "severity": "high",
   "owasp": "ASI-01",
   "pattern": "(\\\\x[0-9a-f]{2}){12,}|from_hex|bytes\\.fromhex|\\$(\\(|\\s)\\s*'\\\\x",
   "description": "Long hex escape sequences or hex-decode-then-execute pattern.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS016",
   "title": "curl|bash remote code execution",
   "category": "rce-download",
   "severity": "critical",
   "owasp": "ASI-06",
   "pattern": "(curl|wget|fetch)\\s*[^\\n|>]{0,200}[|>]\\s*(sudo\\s+)?(bash|sh|zsh|python3?|perl)\\b",
   "description": "Pipes a remote script straight into a shell interpreter.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS017",
   "title": "curl/wget to /tmp then execute",
   "category": "rce-download",
   "severity": "critical",
   "owasp": "ASI-06",
   "pattern": "(curl|wget)[^\\n]*(/tmp|/dev/shm|~/\\.)[^\\n]*&&[^\\n]*(chmod|bash|sh|\\./)",
   "description": "Downloads a binary into a temp path and executes it.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS018",
   "title": "pip install from direct URL (unpinned remote package)",
   "category": "rce-download",
   "severity": "high",
   "owasp": "ASI-06",
   "pattern": "pip3?\\s+install\\s+(--index-url\\s+\\S+\\s+)?(git\\+https?|https?://)",
   "description": "Installs a package from an arbitrary URL instead of a registry.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS019",
   "title": "npm install from direct URL/script",
   "category": "rce-download",
   "severity": "high",
   "owasp": "ASI-06",
   "pattern": "npm\\s+(install|i)\\s+(-g\\s+)?(https?://|git\\+)",
   "description": "Installs an npm package from an arbitrary URL.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS020",
   "title": "Reads SSH keys",
   "category": "credential-access",
   "severity": "critical",
   "owasp": "ASI-04",
   "pattern": "((cat|cp|scp|tar|zip|read|open|base64|xxd|dd|curl|nc|ncat|upload|exfil|copy|send)[^\\n]{0,40}~?/\\.ssh/|~?/\\.ssh/(id_rsa|id_ed25519|id_ecdsa)[^\\n]{0,20}[>|]|\\.ssh/id_[a-z0-9]+[^\\n]{0,10}(>|>>|\\|))",
   "description": "Accesses private SSH key material.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS021",
   "title": "Reads .env / secrets files",
   "category": "credential-access",
   "severity": "critical",
   "owasp": "ASI-04",
   "pattern": "((cat|cp|read|open|source|import|load|upload|scp|curl|tar|zip|grep|awk|sed|python)\\s+[^\\n]{0,40}(\\.env\\b|credentials?\\.json|secrets?\\.(json|ya?ml|txt)|\\.netrc|\\.aws/credentials)|(^|[;&]\\s*)\\.\\s+\\S*\\.env\\b|(\\.env|credentials?\\.json|secrets?\\.(json|ya?ml|txt)|\\.netrc)\\s*(>|>>)\\s*(/|\\S*/\\S+|\\S+\\.\\w{1,4}\\b))",
   "description": "Touches environment/credential files.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS022",
   "title": "Reads API tokens / keychains / password stores",
   "category": "credential-access",
   "severity": "critical",
   "owasp": "ASI-04",
   "pattern": "(api[_-]?key|access[_-]?token|auth[_-]?token|secret[_-]?key|password)['\\\"]?\\s*[:=]\\s*['\\\"][^'\\\"\\s]{8,}|keychain|security\\s+find-generic-password|~\\/\\.netrc|\\.git-credentials",
   "description": "Extracts tokens, keychain entries or stored passwords.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS023",
   "title": "Reads browser/OS credential stores",
   "category": "credential-access",
   "severity": "critical",
   "owasp": "ASI-04",
   "pattern": "((Google/Chrome|Chromium|BraveSoftware|Microsoft/Edge|Mozilla|Firefox)[^\\n]{0,60}(Cookies|Login Data|logins\\.json|key4\\.db|cert9\\.db|Local State|places\\.sqlite)|(Login Data|logins\\.json|key4\\.db|cert9\\.db|NTUSER\\.DAT)|/Library/Keychains|Local State[/\\\\])",
   "description": "Touches browser profile DBs or OS keychain files.",
   "kind": "capability",
   "context": "code",
   "requires_pattern": null,
   "escalate_pattern": "(curl|wget|requests\\.post|urlopen|fetch\\()[^\\n]{0,80}https?://|(Cookies|Login Data|logins\\.json|key4\\.db)[^\\n]{0,60}(>|>>|\\|\\s*(curl|nc))"
  },
  {
   "id": "SS024",
   "title": "Exfil to pastebin-like paste service",
   "category": "exfiltration",
   "severity": "critical",
   "owasp": "ASI-09",
   "pattern": "pastebin\\.com|hastebin|dpaste|ghostbin|termbin|ix\\.io|0x0\\.st|transfer\\.sh|anonfiles|gofile\\.io|catbox\\.moe",
   "description": "Sends data to an anonymous paste site.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS025",
   "title": "Exfil/tunnel via webhook or ngrok",
   "category": "exfiltration",
   "severity": "critical",
   "owasp": "ASI-09",
   "pattern": "webhook\\.site|hooks\\.slack\\.com|discord(app)?\\.com/api/webhooks|ngrok\\.io|ngrok-(tcp|http)|trycloudflare\\.com|tunnelto|loophole\\.io|serveo\\.net",
   "description": "Webhook or reverse-tunnel endpoint used for data exfiltration or C2.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null,
   "escalate_pattern": "(curl|wget|requests\\.post|urlopen|fetch\\()[^\\n]{0,100}(webhook\\.site|hooks\\.slack\\.com|discord|ngrok|trycloudflare|tunnelto|loophole|serveo)"
  },
  {
   "id": "SS026",
   "title": "Post/Upload of collected local data to remote host",
   "category": "exfiltration",
   "severity": "high",
   "owasp": "ASI-09",
   "pattern": "(curl|wget)[^\\n]{0,120}(-d\\s*[@'\\\"]|--data|--form|-F\\s*[@'\\\"]|--upload-file|-T\\s+\\S|--post-file)|requests\\.post\\(|urlopen\\([^)]*(data|json)",
   "description": "Uploads local data to a remote endpoint.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null,
   "escalate_pattern": "\\.env\\b|\\.ssh|credentials?\\.json|secrets?\\.|password|Login Data|/etc/passwd|--upload-file|--post-file|@/tmp/(payload|env)"
  },
  {
   "id": "SS027",
   "title": "Crypto miner: stratum protocol",
   "category": "miner",
   "severity": "critical",
   "owasp": "ASI-06",
   "pattern": "stratum\\+?(tcp|ssl)://|--donate-level|xmrig|minerd|cpuminer|nbminer|ethminer|randomx|cryptonight",
   "description": "Cryptomining indicators.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS028",
   "title": "Crypto miner: known pool domains",
   "category": "miner",
   "severity": "critical",
   "owasp": "ASI-06",
   "pattern": "pool\\.(minexmr|supportxmr|moneroocean)|miningpoolhub\\.com|nanopool\\.org|f2pool\\.com|antpool\\.com|nicehash\\.com|coinhive|hashvault",
   "description": "Connects to a mining pool.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS029",
   "title": "Persistence: crontab modification",
   "category": "persistence",
   "severity": "critical",
   "owasp": "ASI-06",
   "pattern": "(crontab\\s+|/etc/cron\\.(d|daily|hourly)|@reboot)",
   "description": "Creates or edits cron jobs.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS030",
   "title": "Persistence: systemd unit / launchd",
   "category": "persistence",
   "severity": "critical",
   "owasp": "ASI-06",
   "pattern": "/etc/systemd/system|systemctl\\s+(enable|daemon-reload)|~/\\.config/systemd|LaunchAgents/.*\\.plist|launchctl\\s+load",
   "description": "Installs a service unit for persistence.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null,
   "escalate_pattern": "/etc/systemd/system|\\.service\\b|WantedBy=|launchctl\\s+load|~/\\.config/systemd"
  },
  {
   "id": "SS031",
   "title": "Persistence: shell rc / profile modification",
   "category": "persistence",
   "severity": "high",
   "owasp": "ASI-06",
   "pattern": "(>>|>)\\s*~/\\.?(bashrc|zshrc|profile|bash_profile|kshrc)|echo[^\\n]{0,200}(bashrc|zshrc|profile)",
   "description": "Appends commands to a user shell startup file.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": null,
   "escalate_pattern": ">>\\s*[^\\n]*(bashrc|zshrc|profile)[^\\n]*(curl|wget|nc |bash|sh |base64|eval|chmod)|echo[^\\n]*(curl|wget|base64)[^\\n]*(bashrc|zshrc|profile)"
  },
  {
   "id": "SS032",
   "title": "Persistence: git hooks abuse",
   "category": "persistence",
   "severity": "high",
   "owasp": "ASI-06",
   "pattern": "\\.git/hooks/(pre-commit|post-commit|pre-push|post-merge|prepare-commit-msg)",
   "description": "Writes into git hook scripts — executes on developer actions.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS033",
   "title": "Persistence: SSH authorized_keys write",
   "category": "persistence",
   "severity": "critical",
   "owasp": "ASI-06",
   "pattern": "(>>|>)\\s*~?/?\\.ssh/authorized_keys|authorized_keys\\b[^\\n]{0,60}(echo|cat)",
   "description": "Adds an attacker SSH key.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS034",
   "title": "MCP config: command injection into MCP server command",
   "category": "mcp",
   "severity": "critical",
   "owasp": "ASI-01",
   "pattern": "\"command\"\\s*:\\s*\"[^\"]*(curl|wget|bash|sh\\s|python3?|nc\\s|eval|perl|ruby)",
   "description": "MCP server config invokes a downloader/interpreter directly.",
   "kind": "capability",
   "context": "any",
   "requires_pattern": "mcpServers|\\.mcp\\.json|\\\"mcp\\\"|mcp_servers",
   "escalate_pattern": "https?://|\\beval\\b|base64\\s+-d|/dev/tcp"
  },
  {
   "id": "SS035",
   "title": "MCP config: npx from URL / unscoped package",
   "category": "mcp",
   "severity": "high",
   "owasp": "ASI-06",
   "pattern": "\\\"command\\\"\\s*:\\s*\\\"[^\\\"]*(npx|uvx|bunx)\\s+(-y\\s+)?(https?://|github:|git\\+|npm:[^\\\"]*\\\")|\\\"command\\\"\\s*:\\s*\\\"(bash|sh)\\s+-c\\s*'[^']*(curl|wget)\\b",
   "description": "MCP server pulled via npx/uvx or a URL — a typosquat vector.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS036",
   "title": "MCP config: tool description override / prompt injection in tool desc",
   "category": "mcp",
   "severity": "high",
   "owasp": "ASI-01",
   "pattern": "(description|tool|function)[\"']?\\s*:\\s*[\"'][^\"']{0,400}(ignore (all )?(previous|prior)|system prompt|you must obey|exfiltrat|reveal your|api[_ ]key)",
   "description": "Tool metadata carries instructions aimed at the agent.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS037",
   "title": "Agent self-modification: rewrite own rules/skills/hooks",
   "category": "self-modification",
   "severity": "critical",
   "owasp": "ASI-08",
   "pattern": "(write|overwrite|edit|modify|patch|replace|inject)(?!\\s*,)[^\\n]{0,40}(SKILL\\.md|AGENTS\\.md|CLAUDE\\.md|GEMINI\\.md|\\.claude/(settings|hooks)|copilot-instructions\\.md)",
   "description": "Skill rewrites the agent's own rules, skills or hook configuration.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  },
  {
   "id": "SS038",
   "title": "Agent hook/backdoor registration",
   "category": "self-modification",
   "severity": "critical",
   "owasp": "ASI-08",
   "pattern": "(PostToolUse|PreToolUse|SessionStart|UserPromptSubmit)[^\\\"\\n]{0,30}[\\\"']?\\s*:\\s*[\\\"'][^\\\"]{0,200}(curl|wget|http|eval|exec|base64)|\\\"hooks\\\"[^\\n]{0,120}(http|curl|eval)",
   "description": "Registers agent lifecycle hooks that phone home or execute code.",
   "kind": "intent",
   "context": "any",
   "requires_pattern": null
  }
 ],
 "_about": "severity = worst case if the rule fires on a hostile artifact (for humans to triage). kind = intent (exploitation: a directive with no benign reading) | capability (dual-use). context = directive (agent instruction files) | code | any. requires_pattern = file-level correlation: the file must also match this, else the hit is not a finding. Cancellation (docs / negation / placeholders) is generic and lives in verifier.py so the catalog stays declarative. `patterns` are candidates, not findings.",
 "_version": "0.2.0"
}
